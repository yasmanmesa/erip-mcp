# bePaid shop credentials (from merchant.bepaid.by → Shops → Details)
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=

# Express-Pay (sandbox tokens are public in their API docs)
EXPRESS_PAY_TOKEN=
EXPRESS_PAY_SECRET_WORD=
# Optional override (defaults: sandbox-api / api.express-pay.by based on ERIP_MCP_ENV)
# EXPRESS_PAY_API_BASE_URL=https://sandbox-api.express-pay.by/v1

# WEBPAY (merchant storeid + secret from WEBPAY; no public sandbox keys)
WEBPAY_STORE_ID=
WEBPAY_SECRET_KEY=
# Optional: defaults securesandbox.webpay.by / payment.webpay.by
# WEBPAY_PAYMENT_BASE_URL=https://securesandbox.webpay.by/

# Hutki Grosh (merchant login; no public sandbox)
HUTKIGROSH_USER=
HUTKIGROSH_PASSWORD=
# HUTKIGROSH_API_BASE_URL=https://www.hutkigrosh.by/API/v1

# Assist Belarus (merchant_Id; test host by default in sandbox)
ASSIST_MERCHANT_ID=
# ASSIST_PAYMENT_BASE_URL=https://test.paysec.by

# sandbox | production (default: sandbox)
ERIP_MCP_ENV=sandbox

# Required for write tools when ERIP_MCP_ENV=production
ERIP_MCP_ALLOW_WRITE=0

# Optional override of bePaid API base URL (default: https://api.bepaid.by)
# BEPAID_API_BASE_URL=https://api.bepaid.by
